# Copying a token from another machine is not required. Run the device-flow login there.
UPSTREAM_MODE=copilot
PORT=4141
COPILOT_ACCOUNT_TYPE=individual

# Defaults for the portable Codex launcher. CLI flags can override these.
PROXY_MODEL=claude-opus-5
PROXY_REASONING_EFFORT=max

# Use these only for UPSTREAM_MODE=relay. Supply your own endpoint and key.
# UPSTREAM_BASE_URL=https://your-provider.example/v1
# UPSTREAM_API_KEY=replace-with-your-own-key

MODEL_ALIASES='{"gpt-5.3-codex-spark":"gpt-5.3-codex","codex-auto-review":"gpt-5.6-sol","gpt-reserve":"gpt-5.6-sol"}'
EXTRA_PICKER_MODELS=gpt-6-astra,claude-opus-5,claude-sonnet-5,claude-opus-4.8,claude-opus-4.7,claude-sonnet-4.6,claude-haiku-4.5,gemini-3.7-flash,gemini-3.6-flash,grok-4.6,grok-4.5,gpt-5.3-codex,gpt-5.6-sol-fast
PICKER_BASE_SLUG=gpt-5.4-mini

# Keep large concurrent requests from competing for a slow uplink.
UPLOAD_CONCURRENCY=1
UPLOAD_GATE_MIN_KB=64
UPLOAD_GATE_STREAM=1
UPSTREAM_RETRIES=2

# Copilot defaults to 32 MiB; relay defaults to disabled. Set 0 to disable the guard.
# UPSTREAM_MAX_BODY_BYTES=33554432

# Existing last-resort reasoning trimming after an upstream upload timeout.
# It is lossy: set TRIM_REASONING_ON_408=0 to disable it.
TRIM_REASONING_ON_408=1
TRIM_REASONING_KB=0
TRIM_REASONING_KEEP=4

# Optional absolute-path overrides:
# COPILOT_GITHUB_TOKEN_FILE=/absolute/private/path/github-token
# CODEX_MODELS_TEMPLATE=/absolute/path/models-template.json
# CODEX_BIN=/absolute/path/codex
# PICKER_GUARD_CLI_CODEX=/absolute/path/codex
# PICKER_GUARD_APP_CODEX=/Applications/ChatGPT.app/Contents/Resources/codex
# PICKER_GUARD_MODELS_URL=http://127.0.0.1:4141/v1/models
